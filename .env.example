# Copy to .env. Never commit .env.
API_KEY=change-me                 # required: bearer key for /v1/systemone and /metrics
PORT=8080
BIND=127.0.0.1                    # 0.0.0.0 to listen on all interfaces
MODEL=minicpm5-2b,qwen3.5-4b      # presets to load (also: qwen3-4b); first answers jev-latest
RATE_LIMIT=10                     # requests/s per client, 0 = off
REQUEST_TIMEOUT=5m
RENDER_GID=992                    # GPU override only: host group ids
VIDEO_GID=44
